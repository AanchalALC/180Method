{
  "trailingSlash": true,
  "redirects": [
    { "source": "/blog", "destination": "/", "permanent": false },
    { "source": "/blog/:path*", "destination": "/", "permanent": false }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}